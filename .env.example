# Copy this file to .env.local and fill in real values for local development.
# In Vercel, add these under Project Settings -> Environment Variables.
# Never commit a file with real values (only .env.example is tracked in git).

# The shared PIN field workers type in to log in (any digits, e.g. 4-6 digits).
APP_PIN=

# Long random string used to encrypt the login session cookie.
# Generate one with: openssl rand -base64 32
SESSION_SECRET=

# Postgres connection string from Neon (added automatically when you install
# the Neon integration from the Vercel Marketplace and link it to this project).
DATABASE_URL=

# Token for uploading job photos, from Vercel Blob (added automatically when
# you create a Blob store in your Vercel project and link it).
BLOB_READ_WRITE_TOKEN=
